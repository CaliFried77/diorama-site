{
  "name": "living-pixel-diorama",
  "version": "1.6.6",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/build-css.mjs && node scripts/check.mjs",
    "test": "node scripts/build-css.mjs && node build.mjs && node --test tests/*.test.mjs",
    "security": "node scripts/security-audit.mjs",
    "build": "node scripts/build-css.mjs && node build.mjs",
    "dev": "npx netlify-cli dev",
    "test:news": "node --test tests/rss-api.test.mjs tests/news-system.test.mjs tests/news-backup.test.mjs",
    "test:browser": "npm run build && python scripts/browser-smoke.py"
  },
  "engines": {
    "node": ">=22"
  }
}
